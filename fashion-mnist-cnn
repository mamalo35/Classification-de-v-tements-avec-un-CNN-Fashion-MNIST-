pe":"code","source":"(x_train, y_train), (x_test, y_test) = keras.datasets.fashion_mnist.load_data()\n\nx_train = x_train[..., None] / 255.0\nx_test = x_test[..., None] / 255.0\n\nclasses = [\"T-shirt\", \"Pantalon\", \"Pull\", \"Robe\", \"Manteau\",\n           \"Sandale\", \"Chemise\", \"Basket\", \"Sac\", \"Bottine\"]","metadata":{"execution":{"iopub.execute_input":"2026-10-10T14:57:45.990394Z","iopub.status.busy":"2026-10-10T14:57:45.989887Z","iopub.status.idle":"2026-10-10T14:57:47.126434Z","shell.execute_reply":"2026-10-10T14:57:47.125357Z"},"papermill":{"duration":1.142598,"end_time":"2026-10-10T14:57:47.128549+00:00","exception":false,"start_time":"2026-10-10T14:57:45.985951+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Downloading data from https://storage.googleapis.com/tensorflow/tf-keras-datasets/train-labels-idx1-ubyte.gz\n","\u001b[1m29515/29515\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m0s\u001b[0m 0us/step\n","Downloading data from https://storage.googleapis.com/tensorflow/tf-keras-datasets/train-images-idx3-ubyte.gz\n","\u001b[1m26421880/26421880\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m0s\u001b[0m 0us/step\n","Downloading data from https://storage.googleapis.com/tensorflow/tf-keras-datasets/t10k-labels-idx1-ubyte.gz\n","\u001b[1m5148/5148\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m0s\u001b[0m 0us/step\n","Downloading data from https://storage.googleapis.com/tensorflow/tf-keras-datasets/t10k-images-idx3-ubyte.gz\n","\u001b[1m4422102/4422102\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m0s\u001b[0m 0us/step\n"]}],"execution_count":2},{"id":"056ed24f","cell_type":"code","source":"# Aperçu des données\nplt.figure(figsize=(10, 5))\nfor i in range(10):\n    plt.subplot(2, 5, i + 1)\n    plt.imshow(x_train[i].squeeze(), cmap=\"gray\")\n    plt.title(classes[y_train[i]])\n    plt.axis(\"off\")\nplt.savefig(\"images/exemples_donnees.png\", dpi=150, bbox_inches=\"tight\")\nplt.show()","metadata":{"execution":{"iopub.execute_input":"2026-10-10T14:57:47.137527Z","iopub.status.busy":"2026-10-10T14:57:47.136832Z","iopub.status.idle":"2026-10-10T14:57:47.85058Z","shell.execute_reply":"2026-10-10T14:57:47.849734Z"},"papermill":{"duration":0.720095,"end_time":"2026-10-10T14:57:47.852168+00:00","exception":false,"start_time":"2026-10-10T14:57:47.132073+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 1000x500 with 10 Axes>"]},"metadata":{},"output_type":"display_data"}],"execution_count":3},{"id":"407914c5","cell_type":"markdown","source":"## 3. Fonctions utilitaires\n\nCes fonctions évitent de répéter le même code pour chaque modèle.","metadata":{"papermill":{"duration":0.003532,"end_time":"2026-10-10T14:57:47.859247+00:00","exception":false,"start_time":"2026-10-10T14:57:47.855715+00:00","status":"completed"},"tags":[]}},{"id":"00dcf1e0","cell_type":"code","source":"def tracer_courbes(history, nom_fichier):\n    fig, axes = plt.subplots(1, 2, figsize=(12, 4))\n    axes[0].plot(history.history[\"loss\"], label=\"Entraînement\")\n    axes[0].plot(history.history[\"val_loss\"], label=\"Validation\")\n    axes[0].set_xlabel(\"Époque\"); axes[0].set_ylabel(\"Erreur (loss)\"); axes[0].legend()\n    axes[1].plot(history.history[\"accuracy\"], label=\"Entraînement\")\n    axes[1].plot(history.history[\"val_accuracy\"], label=\"Validation\")\n    axes[1].set_xlabel(\"Époque\"); axes[1].set_ylabel(\"Précision\"); axes[1].legend()\n    plt.tight_layout()\n    plt.savefig(f\"images/{nom_fichier}.png\", dpi=150, bbox_inches=\"tight\")\n    plt.show()\n\n\ndef evaluer(model, nom_fichier):\n    _, acc = model.evaluate(x_test, y_test, verbose=0)\n    probs = model.predict(x_test, verbose=0)\n    pred = np.argmax(probs, axis=1)\n    print(f\"Précision sur le test : {acc:.2%} \"\n          f\"({np.sum(pred != y_test)} erreurs sur {len(y_test)} images)\")\n\n    ConfusionMatrixDisplay.from_predictions(y_test, pred, display_labels=classes,\n                                            xticks_rotation=45)\n    plt.savefig(f\"images/{nom_fichier}.png\", dpi=150, bbox_inches=\"tight\")\n    plt.show()\n    return probs, pred","metadata":{"execution":{"iopub.execute_input":"2026-10-10T14:57:47.868453Z","iopub.status.busy":"2026-10-10T14:57:47.868015Z","iopub.status.idle":"2026-10-10T14:57:47.875597Z","shell.execute_reply":"2026-10-10T14:57:47.874845Z"},"papermill":{"duration":0.014195,"end_time":"2026-10-10T14:57:47.877232+00:00","exception":false,"start_time":"2026-10-10T14:57:47.863037+00:00","status":"completed"},"tags":[]},"outputs":[],"execution_count":4},{"id":"92523769","cell_type":"markdown","source":"## 4. Modèle 1 : CNN de base\n\nArchitecture simple : deux couches de convolution suivies de pooling, puis une couche dense avec Dropout.\n\n| Couche | Rôle |\n|---|---|\n| `Conv2D` | Repère des motifs visuels (bords, formes) avec des filtres 3×3 |\n| `MaxPooling2D` | Réduit la taille de l'image en gardant l'essentiel |\n| `Flatten` | Met les données à plat pour les couches denses |\n| `Dense` + `Dropout` | Combine les indices pour décider, en limitant le surapprentissage |\n| `Dense` softmax | Donne une probabilité pour chacune des 10 classes |","metadata":{"papermill":{"duration":0.003604,"end_time":"2026-10-10T14:57:47.884666+00:00","exception":false,"start_time":"2026-10-10T14:57:47.881062+00:00","status":"completed"},"tags":[]}},{"id":"a3ab148a","cell_type":"code","source":"keras.utils.set_random_seed(42)   # hasard fixé pour des résultats reproductibles\n\nmodel_v1 = keras.Sequential([\n    layers.Input(shape=(28, 28, 1)),\n    layers.Conv2D(32, 3, activation=\"relu\"),\n    layers.MaxPooling2D(),\n    layers.Conv2D(64, 3, activation=\"relu\"),\n    layers.MaxPooling2D(),\n    layers.Flatten(),\n    layers.Dense(64, activation=\"relu\"),\n    layers.Dropout(0.5),\n    layers.Dense(10, activation=\"softmax\"),\n])\n\nmodel_v1.compile(optimizer=\"adam\",\n                 loss=\"sparse_categorical_crossentropy\",\n                 metrics=[\"accuracy\"])\nmodel_v1.summary()","metadata":{"execution":{"iopub.execute_input":"2026-10-10T14:57:47.893317Z","iopub.status.busy":"2026-10-10T14:57:47.892888Z","iopub.status.idle":"2026-10-10T14:57:54.377339Z","shell.execute_reply":"2026-10-10T14:57:54.376637Z"},"papermill":{"duration":6.490324,"end_time":"2026-10-10T14:57:54.378726+00:00","exception":false,"start_time":"2026-10-10T14:57:47.888402+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stderr","output_type":"stream","text":["WARNING: All log messages before absl::InitializeLog() is called are written to STDERR\n","I0000 00:00:1791644272.277326      23 gpu_device.cc:2020] Created device /job:localhost/replica:0/task:0/device:GPU:0 with 13756 MB memory:  -> device: 0, name: Tesla T4, pci bus id: 0000:00:04.0, compute capability: 7.5\n","I0000 00:00:1791644272.281081      23 gpu_device.cc:2020] Created device /job:localhost/replica:0/task:0/device:GPU:1 with 13756 MB memory:  -> device: 1, name: Tesla T4, pci bus id: 0000:00:05.0, compute capability: 7.5\n"]},{"data":{"text/html":["<pre style=\"white-space:pre;overflow-x:auto;line-height:normal;font-family:Menlo,'DejaVu Sans Mono',consolas,'Courier New',monospace\"><span style=\"font-weight: bold\">Model: \"sequential\"</span>\n","</pre>\n"],"text/plain":["\u001b[1mModel: \"sequential\"\u001b[0m\n"]},"metadata":{},"output_type":"display_data"},{"data":{"text/html":["<pre style=\"white-space:pre;overflow-x:auto;line-height:normal;font-family:Menlo,'DejaVu Sans Mono',consolas,'Courier New',monospace\">┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━┓\n","┃<span style=\"font-weight: bold\"> Layer (type)                    </span>┃<span style=\"font-weight: bold\"> Output Shape           </span>┃<span style=\"font-weight: bold\">       Param #